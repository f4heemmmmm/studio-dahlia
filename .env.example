# Copy to .env.local and fill in. Also add these in your host's environment settings (e.g. Vercel).

# Resend API key with sending access: https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives enquiries (the studio's email address)
ENQUIRY_TO_EMAIL=

# Public site address, used for link-preview images (optional on Vercel)
SITE_URL=https://www.studiodahliaevents.com

# Sender shown on enquiry emails; must be on a domain verified in Resend
ENQUIRY_FROM_EMAIL="Studio Dahlia <enquiries@studiodahliaevents.com>"
